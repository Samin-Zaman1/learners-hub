generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id          String       @id @default(uuid())
  userId      String
  courseId    String?
  taskId      String?
  type        ActivityType
  title       String
  description String?
  timestamp   DateTime     @default(now())
  status      String?
  progress    Int?
  grade       String?
  dueDate     DateTime?
  Course      Course?      @relation(fields: [courseId], references: [id])
  User        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  Task        Task?        @relation(fields: [taskId], references: [id])
}

model Announcement {
  id               String               @id @default(uuid())
  courseId         String
  createdBy        String
  title            String
  content          String
  type             AnnouncementType     @default(GENERAL)
  priority         AnnouncementPriority @default(MEDIUM)
  isPinned         Boolean              @default(false)
  hasAttachment    Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  Course           Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator          User                 @relation("CreatedAnnouncements", fields: [createdBy], references: [id], onDelete: Cascade)
  AnnouncementRead AnnouncementRead[]
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  userId         String
  announcementId String
  isRead         Boolean      @default(false)
  readAt         DateTime?
  Announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
}

model Course {
  id               String             @id @default(uuid())
  title            String
  code             String             @unique
  description      String?
  instructorId     String
  color            String             @default("#667eea")
  credits          Int                @default(3)
  semester         String
  status           CourseStatus       @default(DRAFT)
  level            String             @default("Beginner")
  duration         String?
  prerequisites    String[]
  objectives       String[]
  isPublished      Boolean            @default(false)
  publishedAt      DateTime?
  invitationCode   String?            @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  Activity         Activity[]
  Announcement     Announcement[]
  instructor       User               @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  CourseInvitation CourseInvitation[]
  CourseMaterial   CourseMaterial[]
  CourseModule     CourseModule[]
  Enrollment       Enrollment[]
  ScheduleEvent    ScheduleEvent[]
  Task             Task[]
}

model Enrollment {
  id         String       @id @default(uuid())
  userId     String
  courseId   String
  progress   Int          @default(0)
  grade      String?
  status     CourseStatus @default(ACTIVE)
  enrolledAt DateTime     @default(now())
  Course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  User       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model ScheduleEvent {
  id         String    @id @default(uuid())
  courseId   String
  createdBy  String
  title      String
  type       String    @default("lecture")
  startTime  String
  endTime    String
  location   String?
  recurrence String?   // weekly, daily, one-time
  dayOfWeek  Int?      // 0=Sunday, 1=Monday, etc
  startDate  DateTime
  endDate    DateTime?
  color      String    @default("#667eea")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  Course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator    User      @relation("CreatedSchedules", fields: [createdBy], references: [id], onDelete: Cascade)
}

model ScheduleTemplate {
  id          String   @id @default(uuid())
  userId      String
  name        String
  description String?
  pattern     String   // MWF, TTh, etc.
  events      Json     // Array of event configurations
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  creator     User     @relation("CreatedScheduleTemplates", fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id            String           @id @default(uuid())
  courseId      String
  createdBy     String
  title         String
  description   String?
  dueDate       DateTime
  dueTime       String?
  priority      TaskPriority     @default(MEDIUM)
  type          String           @default("assignment")
  maxPoints     Int?
  estimatedTime String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  Course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator       User             @relation("CreatedTasks", fields: [createdBy], references: [id], onDelete: Cascade)
  submissions   TaskSubmission[]
  activities    Activity[]
}

model TaskSubmission {
  id          String     @id @default(uuid())
  taskId      String
  studentId   String
  status      TaskStatus @default(PENDING)
  progress    Int        @default(0)
  grade       String?
  points      Int?
  submittedAt DateTime?
  feedback    String?
  gradedBy    String?
  gradedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student     User       @relation("TaskSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  grader      User?      @relation("GradedBy", fields: [gradedBy], references: [id])

  @@unique([taskId, studentId])
}

model User {
  id                                                String             @id @default(uuid())
  email                                             String             @unique
  passwordHash                                      String
  role                                              Role               @default(STUDENT)
  firstName                                         String?
  lastName                                          String?
  profileImage                                      String?
  createdAt                                         DateTime           @default(now())
  verificationCode                                  String?
  verified                                          Boolean            @default(false)
  Activity                                          Activity[]
  AnnouncementRead                                  AnnouncementRead[]
  CoursesInstructing                                Course[]           @relation("CourseInstructor")
  CourseInvitation_CourseInvitation_invitedByToUser CourseInvitation[] @relation("CourseInvitation_invitedByToUser")
  CourseInvitation_CourseInvitation_studentIdToUser CourseInvitation[] @relation("CourseInvitation_studentIdToUser")
  Enrollment                                        Enrollment[]
  CreatedTasks                                      Task[]               @relation("CreatedTasks")
  TaskSubmissions                                   TaskSubmission[]     @relation("TaskSubmissions")
  GradedSubmissions                                 TaskSubmission[]     @relation("GradedBy")
  CreatedSchedules                                  ScheduleEvent[]      @relation("CreatedSchedules")
  CreatedAnnouncements                              Announcement[]       @relation("CreatedAnnouncements")
  CreatedScheduleTemplates                          ScheduleTemplate[]   @relation("CreatedScheduleTemplates")
}

model CourseModule {
  id             String           @id @default(uuid())
  courseId       String
  title          String
  description    String?
  order          Int
  isPublished    Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  CourseMaterial CourseMaterial[]
  Course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model CourseMaterial {
  id          String        @id @default(uuid())
  courseId    String
  moduleId    String?
  title       String
  description String?
  type        MaterialType
  fileUrl     String?
  content     String?
  fileSize    Int?
  duration    String?
  order       Int
  isPublished Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Module      CourseModule? @relation(fields: [moduleId], references: [id])
}

model CourseInvitation {
  id                                    String   @id
  courseId                              String
  studentId                             String
  invitedBy                             String
  status                                String   @default("pending")
  createdAt                             DateTime @default(now())
  Course                                Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  User_CourseInvitation_invitedByToUser User     @relation("CourseInvitation_invitedByToUser", fields: [invitedBy], references: [id], onDelete: Cascade)
  User_CourseInvitation_studentIdToUser User     @relation("CourseInvitation_studentIdToUser", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
}

enum ActivityType {
  ASSIGNMENT
  GRADE
  SUBMISSION
  ANNOUNCEMENT
  ACHIEVEMENT
}

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
}

enum AnnouncementType {
  URGENT
  GENERAL
  EVENT
  REMINDER
}

enum CourseStatus {
  DRAFT
  ASSIGNED
  ACTIVE
  COMPLETED
  DROPPED
  PUBLISHED
  ARCHIVED
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  GRADED
}

enum MaterialType {
  VIDEO
  PDF
  AUDIO
  DOCUMENT
  LINK
  QUIZ
  ASSIGNMENT
}
