generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id          String       @id @default(uuid())
  userId      String
  courseId    String?
  type        ActivityType
  title       String
  description String?
  timestamp   DateTime     @default(now())
  status      String?
  progress    Int?
  grade       String?
  dueDate     DateTime?
  Course      Course?      @relation(fields: [courseId], references: [id])
  User        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id               String               @id @default(uuid())
  courseId         String?
  title            String
  content          String
  author           String
  type             AnnouncementType     @default(GENERAL)
  priority         AnnouncementPriority @default(MEDIUM)
  hasAttachment    Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime
  Course           Course?              @relation(fields: [courseId], references: [id])
  AnnouncementRead AnnouncementRead[]
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  userId         String
  announcementId String
  isRead         Boolean      @default(false)
  readAt         DateTime?
  Announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
}

model Attendance {
  id               String             @id @default(uuid())
  scheduleId       String?
  courseId         String
  date             DateTime
  instructorId     String
  status           AttendanceStatus   @default(PENDING)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  Course           Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  User             User               @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  ScheduleEvent    ScheduleEvent?     @relation(fields: [scheduleId], references: [id])
  AttendanceRecord AttendanceRecord[]

  @@index([courseId, date])
}

model AttendanceRecord {
  id                                    String                 @id @default(uuid())
  attendanceId                          String
  studentId                             String
  status                                AttendanceRecordStatus @default(PRESENT)
  markedAt                              DateTime               @default(now())
  markedBy                              String
  notes                                 String?
  Attendance                            Attendance             @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  User_AttendanceRecord_markedByToUser  User                   @relation("AttendanceRecord_markedByToUser", fields: [markedBy], references: [id], onDelete: Cascade)
  User_AttendanceRecord_studentIdToUser User                   @relation("AttendanceRecord_studentIdToUser", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([attendanceId, studentId])
  @@index([studentId, attendanceId])
}

model Course {
  id             String           @id @default(uuid())
  title          String
  code           String           @unique
  description    String?
  instructorId   String
  instructor     User             @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  color          String           @default("#667eea")
  credits        Int              @default(3)
  semester       String
  status         CourseStatus     @default(DRAFT)
  level          String?
  maxEnrollments Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  invitationCode String?          @unique
  Activity       Activity[]
  Announcement   Announcement[]
  Attendance     Attendance[]
  Enrollment     Enrollment[]
  ScheduleEvent  ScheduleEvent[]
  Task           Task[]
  CourseModule   CourseModule[]
  CourseMaterial CourseMaterial[]

  @@index([instructorId])
}

model Enrollment {
  id         String       @id @default(uuid())
  userId     String
  courseId   String
  progress   Int          @default(0)
  grade      String?
  status     CourseStatus @default(ACTIVE)
  enrolledAt DateTime     @default(now())
  Course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  User       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model ScheduleEvent {
  id         String       @id @default(uuid())
  userId     String
  courseId   String?
  title      String
  instructor String?
  startTime  String
  endTime    String
  location   String?
  type       String       @default("lecture")
  date       DateTime
  recurrence String?      @default("one-time")
  dayOfWeek  Int?
  startDate  DateTime?
  endDate    DateTime?
  createdBy  String?
  color      String       @default("#667eea")
  createdAt  DateTime     @default(now())
  Attendance Attendance[]
  Course     Course?      @relation(fields: [courseId], references: [id])
  User       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id             String           @id @default(uuid())
  userId         String
  courseId       String?
  title          String
  description    String?
  dueDate        DateTime
  dueTime        String?
  priority       TaskPriority     @default(MEDIUM)
  type           String           @default("assignment")
  progress       Int              @default(0)
  status         TaskStatus       @default(PENDING)
  estimatedTime  String?
  maxPoints      Int?             @default(100)
  createdBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  Course         Course?          @relation(fields: [courseId], references: [id])
  User           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  TaskSubmission TaskSubmission[]
}

model User {
  id                                                String             @id @default(uuid())
  email                                             String             @unique
  passwordHash                                      String
  firstName                                         String?
  lastName                                          String?
  profileImage                                      String?
  role                                              Role               @default(STUDENT)
  createdAt                                         DateTime           @default(now())
  verificationCode                                  String?
  verified                                          Boolean            @default(false)
  Activity                                          Activity[]
  AnnouncementRead                                  AnnouncementRead[]
  Attendance                                        Attendance[]
  AttendanceRecord_AttendanceRecord_markedByToUser  AttendanceRecord[] @relation("AttendanceRecord_markedByToUser")
  AttendanceRecord_AttendanceRecord_studentIdToUser AttendanceRecord[] @relation("AttendanceRecord_studentIdToUser")
  CoursesInstructing                                Course[]           @relation("CourseInstructor")
  Enrollment                                        Enrollment[]
  ScheduleEvent                                     ScheduleEvent[]
  Task                                              Task[]
  TaskSubmissionsGraded                             TaskSubmission[]   @relation("GradedBy")
  TaskSubmissionsStudent                            TaskSubmission[]   @relation("StudentSubmission")
}

model TaskSubmission {
  id          String               @id @default(uuid())
  taskId      String
  studentId   String
  status      SubmissionStatus     @default(PENDING)
  submittedAt DateTime?
  points      Int?
  feedback    String?
  gradedBy    String?
  gradedAt    DateTime?
  fileUrl     String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  Task        Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  Student     User                 @relation("StudentSubmission", fields: [studentId], references: [id], onDelete: Cascade)
  Grader      User?                @relation("GradedBy", fields: [gradedBy], references: [id])

  @@unique([taskId, studentId])
  @@index([studentId])
  @@index([taskId])
}

model CourseModule {
  id             String           @id @default(uuid())
  courseId       String
  title          String
  description    String?
  order          Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  Course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  CourseMaterial CourseMaterial[]

  @@index([courseId])
}

model CourseMaterial {
  id          String        @id @default(uuid())
  courseId    String
  moduleId    String?
  title       String
  description String?
  type        MaterialType  @default(DOCUMENT)
  fileUrl     String?
  content     String?
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Module      CourseModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([moduleId])
}

enum ActivityType {
  ASSIGNMENT
  GRADE
  SUBMISSION
  ANNOUNCEMENT
  ACHIEVEMENT
}

enum AnnouncementPriority {
  LOW
  MEDIUM
  HIGH
}

enum AnnouncementType {
  URGENT
  GENERAL
  EVENT
  REMINDER
}

enum AttendanceRecordStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AttendanceStatus {
  PENDING
  TAKEN
}

enum CourseStatus {
  ACTIVE
  COMPLETED
  DROPPED
  DRAFT
}

enum Role {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum SubmissionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  GRADED
  LATE
}

enum MaterialType {
  DOCUMENT
  VIDEO
  LINK
  QUIZ
  ASSIGNMENT
}

