# Environment
NODE_ENV=development

# Database
# For local development:
DATABASE_URL="postgresql://user:password@localhost:5432/champius_db"
# For production (Railway/Render will provide this automatically):
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# JWT Secret (IMPORTANT: Use a strong random string in production)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-minimum-32-chars"

# Client Origin (Frontend URL)
# For local development:
CLIENT_ORIGIN="http://localhost:3000"
# For production (add your Vercel URL):
# CLIENT_ORIGIN="https://your-app.vercel.app,https://your-app-preview.vercel.app"
# Or allow all origins (not recommended for production):
# CLIENT_ORIGIN="*"

# Port
PORT=4000

# Email Configuration (Optional - for password reset)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# EMAIL_FROM="noreply@champius.com"
