# Environment
NODE_ENV=development

# Database (local: `npm run db:up` from the repo root starts Postgres in Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/champius"

# JWT secret. Required in production (Render generates one); the API refuses to start without it.
JWT_SECRET="replace-with-a-long-random-string"

# Allowed frontend origins, comma-separated
CLIENT_ORIGIN="http://localhost:3000"
# CLIENT_ORIGIN="https://your-app.vercel.app,https://your-app-preview.vercel.app"

# Port
PORT=4000

# Email (optional). For local testing use MailHog from docker-compose:
# SMTP_HOST="localhost"
# SMTP_PORT=1025
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="noreply@learnershub.com"
